{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "architecture-record.1",
  "title": "Architecture record",
  "type": "object",
  "required": [
    "goal",
    "scope",
    "decisions",
    "constraints",
    "components",
    "interfaces",
    "files",
    "steps",
    "risks",
    "tests",
    "blocking_questions"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "decided",
              "accepted",
              "final",
              "open"
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "check": {
            "type": "string"
          }
        }
      }
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonblocking_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "self_assessed_simple": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
