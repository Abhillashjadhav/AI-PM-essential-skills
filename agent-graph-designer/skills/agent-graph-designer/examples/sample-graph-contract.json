{
  "name": "ai-feature-launch-readiness",
  "version": "0.1.0",
  "qualification": {
    "verdict": "GRAPH_REQUIRED",
    "structural_evidence": "Three independent specialist reviews can run from one frozen candidate and must converge.",
    "coordination_evidence": "Each review has separate evidence, permissions, verification gates, and a deterministic all-required join."
  },
  "outcome": {
    "north_star": "Percentage of evaluated release candidates that receive a correct, evidence-backed launch decision within two working days.",
    "leading_metrics": [
      "valid branch-artifact rate",
      "time to complete all reviews",
      "join-block rate",
      "repair rate"
    ],
    "guardrails": [
      "no fabricated evidence",
      "synthetic data only in this example",
      "no reviewer approves its own work",
      "no autonomous deployment"
    ],
    "trade_off": "Lower wall-clock time versus higher orchestration and token cost."
  },
  "start_node": "freeze-candidate",
  "terminal_nodes": [
    "ready-for-human-approved-release",
    "blocked"
  ],
  "node_cap": 10,
  "concurrency_cap": 3,
  "total_budget": {
    "max_seconds": 900,
    "max_cost_units": 100
  },
  "max_repairs_per_node": 2,
  "human_approval_actions": [
    "deploy",
    "merge",
    "publish"
  ],
  "kill_switch": "Stop new dispatch, checkpoint current branch results, and mark the run BLOCKED.",
  "nodes": [
    {
      "id": "freeze-candidate",
      "type": "WORKER",
      "purpose": "Validate and freeze one synthetic release candidate digest for all reviewers.",
      "owner": "release-coordinator",
      "inputs": ["synthetic_release_candidate"],
      "outputs": ["release_candidate_digest"],
      "reads_state": [],
      "writes_state": ["release_candidate_digest"],
      "allowed_tools": ["local-file-reader", "sha256"],
      "permissions": {"read": ["synthetic-fixture"], "write": ["release_candidate_digest"], "actions": []},
      "model_policy": "deterministic code; no model required",
      "budget": {"max_seconds": 30, "max_cost_units": 1},
      "timeout_seconds": 30,
      "max_attempts": 1,
      "verifier": {"role": "candidate-integrity-verifier", "gates": ["digest exists", "fixture is synthetic"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "product-outcome-review",
      "type": "LOOP",
      "purpose": "Test whether the candidate solves the stated support-agent outcome.",
      "owner": "product-reviewer",
      "inputs": ["release_candidate_digest", "synthetic_product_evidence"],
      "outputs": ["product_review"],
      "reads_state": ["release_candidate_digest"],
      "writes_state": ["product_review"],
      "allowed_tools": ["local-eval-runner"],
      "permissions": {"read": ["synthetic-product-evidence"], "write": ["product_review"], "actions": []},
      "model_policy": "smallest model meeting the anchored product-review rubric",
      "budget": {"max_seconds": 240, "max_cost_units": 25},
      "timeout_seconds": 240,
      "max_attempts": 2,
      "verifier": {"role": "product-evidence-verifier", "gates": ["candidate digest matches", "outcome threshold present", "evidence links present"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "model-quality-review",
      "type": "LOOP",
      "purpose": "Run binary model-quality gates and the calibrated quality rubric.",
      "owner": "model-quality-reviewer",
      "inputs": ["release_candidate_digest", "synthetic_eval_results"],
      "outputs": ["quality_review"],
      "reads_state": ["release_candidate_digest"],
      "writes_state": ["quality_review"],
      "allowed_tools": ["local-eval-runner"],
      "permissions": {"read": ["synthetic-eval-results"], "write": ["quality_review"], "actions": []},
      "model_policy": "deterministic gates plus calibrated judge only where required",
      "budget": {"max_seconds": 240, "max_cost_units": 35},
      "timeout_seconds": 240,
      "max_attempts": 2,
      "verifier": {"role": "quality-gate-verifier", "gates": ["candidate digest matches", "all binary gates reported", "uncertainty recorded"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "safety-privacy-review",
      "type": "LOOP",
      "purpose": "Check privacy, restricted-data, and unsafe-output release gates.",
      "owner": "safety-reviewer",
      "inputs": ["release_candidate_digest", "synthetic_safety_evidence"],
      "outputs": ["safety_review"],
      "reads_state": ["release_candidate_digest"],
      "writes_state": ["safety_review"],
      "allowed_tools": ["local-policy-checker"],
      "permissions": {"read": ["synthetic-safety-evidence"], "write": ["safety_review"], "actions": []},
      "model_policy": "deterministic policy gates; model may explain but cannot waive a gate",
      "budget": {"max_seconds": 240, "max_cost_units": 25},
      "timeout_seconds": 240,
      "max_attempts": 2,
      "verifier": {"role": "safety-gate-verifier", "gates": ["candidate digest matches", "restricted-data gate reported", "unsafe-output gate reported"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "review-join",
      "type": "JOIN",
      "purpose": "Admit all schema-valid review artifacts and synthesize a launch recommendation.",
      "owner": "release-coordinator",
      "inputs": ["product_review", "quality_review", "safety_review"],
      "outputs": ["launch_recommendation"],
      "reads_state": ["product_review", "quality_review", "safety_review"],
      "writes_state": ["launch_recommendation"],
      "allowed_tools": ["local-contract-validator"],
      "permissions": {"read": ["verified-review-artifacts"], "write": ["launch_recommendation"], "actions": []},
      "model_policy": "deterministic gate synthesis; no model required",
      "budget": {"max_seconds": 60, "max_cost_units": 5},
      "timeout_seconds": 60,
      "max_attempts": 1,
      "verifier": {"role": "join-contract-verifier", "gates": ["all branches present", "all schemas valid", "digests agree"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "human-launch-gate",
      "type": "HUMAN_GATE",
      "purpose": "Present verified evidence and wait for an accountable human launch decision.",
      "owner": "accountable-product-leader",
      "inputs": ["launch_recommendation"],
      "outputs": ["human_decision"],
      "reads_state": ["launch_recommendation"],
      "writes_state": ["human_decision"],
      "allowed_tools": ["approval-outbox"],
      "permissions": {"read": ["launch_recommendation"], "write": ["human_decision"], "actions": ["request-approval"]},
      "model_policy": "no model may make the approval decision",
      "budget": {"max_seconds": 300, "max_cost_units": 1},
      "timeout_seconds": 300,
      "max_attempts": 1,
      "verifier": {"role": "approval-record-verifier", "gates": ["named approver", "decision timestamp", "candidate digest"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "ready-for-human-approved-release",
      "type": "TERMINAL",
      "purpose": "Record that the human-approved candidate may enter the separate release process.",
      "owner": "release-coordinator",
      "inputs": ["human_decision"],
      "outputs": ["release-readiness-record"],
      "reads_state": ["human_decision"],
      "writes_state": [],
      "allowed_tools": [],
      "permissions": {"read": ["human_decision"], "write": [], "actions": []},
      "model_policy": "none",
      "budget": {"max_seconds": 1, "max_cost_units": 0},
      "timeout_seconds": 1,
      "max_attempts": 1,
      "verifier": {"role": "terminal-state-verifier", "gates": ["human decision is APPROVE"]},
      "on_exhaustion": "BLOCKED"
    },
    {
      "id": "blocked",
      "type": "TERMINAL",
      "purpose": "Preserve evidence and state the exact unblock requirement without claiming success.",
      "owner": "release-coordinator",
      "inputs": ["blocking_reason"],
      "outputs": ["blocking-report"],
      "reads_state": ["release_candidate_digest"],
      "writes_state": [],
      "allowed_tools": [],
      "permissions": {"read": ["run-state"], "write": [], "actions": []},
      "model_policy": "none",
      "budget": {"max_seconds": 1, "max_cost_units": 0},
      "timeout_seconds": 1,
      "max_attempts": 1,
      "verifier": {"role": "blocking-report-verifier", "gates": ["reason present", "unblock requirement present"]},
      "on_exhaustion": "BLOCKED"
    }
  ],
  "edges": [
    {"id": "fan-product", "source": "freeze-candidate", "target": "product-outcome-review", "type": "FAN_OUT", "condition": "candidate_digest_verified", "evidence_required": ["release_candidate_digest"], "state_mapping": {"release_candidate_digest": "release_candidate_digest"}, "priority": 1},
    {"id": "fan-quality", "source": "freeze-candidate", "target": "model-quality-review", "type": "FAN_OUT", "condition": "candidate_digest_verified", "evidence_required": ["release_candidate_digest"], "state_mapping": {"release_candidate_digest": "release_candidate_digest"}, "priority": 1},
    {"id": "fan-safety", "source": "freeze-candidate", "target": "safety-privacy-review", "type": "FAN_OUT", "condition": "candidate_digest_verified", "evidence_required": ["release_candidate_digest"], "state_mapping": {"release_candidate_digest": "release_candidate_digest"}, "priority": 1},
    {"id": "freeze-failed", "source": "freeze-candidate", "target": "blocked", "type": "FAIL", "condition": "candidate_digest_invalid OR attempt_exhausted OR timeout", "evidence_required": ["candidate_freeze_failure"], "state_mapping": {"candidate_freeze_failure": "blocking_reason"}, "priority": 2},
    {"id": "product-retry", "source": "product-outcome-review", "target": "product-outcome-review", "type": "RETRY", "condition": "verification_failed_or_timeout AND attempts < 2", "evidence_required": ["verification_failure_or_timeout"], "state_mapping": {}, "priority": 1},
    {"id": "quality-retry", "source": "model-quality-review", "target": "model-quality-review", "type": "RETRY", "condition": "verification_failed_or_timeout AND attempts < 2", "evidence_required": ["verification_failure_or_timeout"], "state_mapping": {}, "priority": 1},
    {"id": "safety-retry", "source": "safety-privacy-review", "target": "safety-privacy-review", "type": "RETRY", "condition": "verification_failed_or_timeout AND attempts < 2", "evidence_required": ["verification_failure_or_timeout"], "state_mapping": {}, "priority": 1},
    {"id": "product-join", "source": "product-outcome-review", "target": "review-join", "type": "FAN_IN", "condition": "product_review_verified", "evidence_required": ["product_review"], "state_mapping": {"product_review": "product_review"}, "priority": 2},
    {"id": "quality-join", "source": "model-quality-review", "target": "review-join", "type": "FAN_IN", "condition": "quality_review_verified", "evidence_required": ["quality_review"], "state_mapping": {"quality_review": "quality_review"}, "priority": 2},
    {"id": "safety-join", "source": "safety-privacy-review", "target": "review-join", "type": "FAN_IN", "condition": "safety_review_verified", "evidence_required": ["safety_review"], "state_mapping": {"safety_review": "safety_review"}, "priority": 2},
    {"id": "product-exhausted", "source": "product-outcome-review", "target": "blocked", "type": "FAIL", "condition": "attempts >= 2 AND verification_failed_or_timeout", "evidence_required": ["verification_failure_or_timeout"], "state_mapping": {"verification_failure_or_timeout": "blocking_reason"}, "priority": 3},
    {"id": "quality-exhausted", "source": "model-quality-review", "target": "blocked", "type": "FAIL", "condition": "attempts >= 2 AND verification_failed_or_timeout", "evidence_required": ["verification_failure_or_timeout"], "state_mapping": {"verification_failure_or_timeout": "blocking_reason"}, "priority": 3},
    {"id": "safety-exhausted", "source": "safety-privacy-review", "target": "blocked", "type": "FAIL", "condition": "attempts >= 2 AND verification_failed_or_timeout", "evidence_required": ["verification_failure_or_timeout"], "state_mapping": {"verification_failure_or_timeout": "blocking_reason"}, "priority": 3},
    {"id": "join-pass", "source": "review-join", "target": "human-launch-gate", "type": "PASS", "condition": "all_required_reviews_valid", "evidence_required": ["launch_recommendation"], "state_mapping": {"launch_recommendation": "launch_recommendation"}, "priority": 1},
    {"id": "join-fail", "source": "review-join", "target": "blocked", "type": "FAIL", "condition": "missing_invalid_stale_conflicting_or_timed_out_review", "evidence_required": ["join_failure"], "state_mapping": {"join_failure": "blocking_reason"}, "priority": 2},
    {"id": "human-approve", "source": "human-launch-gate", "target": "ready-for-human-approved-release", "type": "APPROVE", "condition": "signed_human_decision == APPROVE", "evidence_required": ["human_decision"], "state_mapping": {"human_decision": "human_decision"}, "priority": 1},
    {"id": "human-reject", "source": "human-launch-gate", "target": "blocked", "type": "REJECT", "condition": "signed_human_decision == REJECT OR approval_timeout", "evidence_required": ["human_decision_or_timeout"], "state_mapping": {"human_decision_or_timeout": "blocking_reason"}, "priority": 2}
  ],
  "state": {
    "schema_version": "0.1.0",
    "idempotency_key": "release_candidate_digest",
    "checkpoint_after": ["freeze-candidate", "product-outcome-review", "model-quality-review", "safety-privacy-review", "review-join", "human-launch-gate"],
    "merge_policy": "Only review-join may synthesize verified branch artifacts; source artifacts remain immutable.",
    "conflict_policy": "Any digest mismatch or conflicting disqualifying gate blocks the graph.",
    "retention_or_redaction": "Synthetic example only; retain contract and verification metadata, never customer content.",
    "fields": [
      {"name": "release_candidate_digest", "schema": "non-empty string", "writers": ["freeze-candidate"], "readers": ["product-outcome-review", "model-quality-review", "safety-privacy-review", "blocked"], "sensitivity": "internal", "freshness": "fixed for run"},
      {"name": "product_review", "schema": "review-v1", "writers": ["product-outcome-review"], "readers": ["review-join"], "sensitivity": "internal", "freshness": "current run"},
      {"name": "quality_review", "schema": "review-v1", "writers": ["model-quality-review"], "readers": ["review-join"], "sensitivity": "internal", "freshness": "current run"},
      {"name": "safety_review", "schema": "review-v1", "writers": ["safety-privacy-review"], "readers": ["review-join"], "sensitivity": "restricted", "freshness": "current run"},
      {"name": "launch_recommendation", "schema": "launch-recommendation-v1", "writers": ["review-join"], "readers": ["human-launch-gate"], "sensitivity": "internal", "freshness": "current run"},
      {"name": "human_decision", "schema": "signed-decision-v1", "writers": ["human-launch-gate"], "readers": ["ready-for-human-approved-release", "blocked"], "sensitivity": "internal", "freshness": "current run"}
    ]
  },
  "joins": [
    {
      "node_id": "review-join",
      "required_branches": ["product-outcome-review", "model-quality-review", "safety-privacy-review"],
      "policy": "ALL_REQUIRED",
      "artifact_schema": "review-v1",
      "timeout_seconds": 300,
      "on_missing": "BLOCKED",
      "on_failed": "BLOCKED",
      "on_stale": "BLOCKED",
      "on_conflict": "BLOCKED"
    }
  ]
}
