{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adapter-pin.1",
  "title": "Codex adapter pin manifest",
  "type": "object",
  "required": [
    "executable",
    "version",
    "sha256",
    "schema_digest",
    "launcher",
    "compat_problems",
    "compat_notes",
    "approved_by",
    "approved_at",
    "adapter_version"
  ],
  "properties": {
    "executable": {
      "type": "string",
      "pattern": "^/"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Measured Codex installation pinned by the owner. It carries no spend-enforcement claims: enforcement is only ever decided from live provider signals by code-defined mechanisms."
}
