{
  "version": 1,
  "cases": [
    {
      "id": "calibrate-mixed-sources",
      "mode": "calibrate",
      "sources": [
        {
          "id": "pair-1",
          "type": "draft_final_pair",
          "positive": true,
          "text": "Draft used a slogan. Final opened with the operational consequence and ended with a decision."
        },
        {
          "id": "pair-2",
          "type": "draft_final_pair",
          "positive": true,
          "text": "Draft hid the trade-off. Final stated the trade-off before the recommendation."
        },
        {
          "id": "final-1",
          "type": "accepted_final",
          "positive": true,
          "text": "A direct product note that moves from failure to mechanism to decision."
        },
        {
          "id": "final-2",
          "type": "accepted_final",
          "positive": true,
          "text": "A short update using plain verbs and uneven sentence lengths."
        },
        {
          "id": "prompt-1",
          "type": "raw_prompt",
          "positive": true,
          "text": "First explain the consequence. Then show the mechanism and the trade-off."
        },
        {
          "id": "ai-1",
          "type": "ai_draft",
          "positive": false,
          "accepted": false,
          "text": "Here is a transformative framework that changes everything."
        }
      ],
      "expected": {
        "profile_status": "calibrated",
        "signals": [
          {
            "id": "causal-decision",
            "description": "Moves from consequence through mechanism to decision.",
            "confidence": "observed",
            "evidence_ids": ["pair-1", "final-1", "prompt-1"]
          },
          {
            "id": "explicit-tradeoff",
            "description": "States the trade-off before the recommendation.",
            "confidence": "observed",
            "evidence_ids": ["pair-2", "final-1", "prompt-1"]
          },
          {
            "id": "direct-cadence",
            "description": "Uses plain verbs with varied sentence lengths.",
            "confidence": "observed",
            "evidence_ids": ["pair-1", "final-1", "final-2"]
          }
        ],
        "polish_boundary": {
          "preserve": ["causal reasoning", "directness"],
          "clean": ["typos", "filler"]
        }
      },
      "must_use_source_ids": ["pair-1", "pair-2", "final-1"],
      "must_not_use_source_ids": ["ai-1"],
      "must_not_persist": []
    },
    {
